.picture-selector{ id: local_assigns[:id], class: ('picture-inserter' if local_assigns[:editor_target]), data: { controller: 'picture-selector', action: 'keydown@window->picture-selector#keydown turbo:before-cache@document->picture-selector#disconnect', 'picture-selector-url-value' => admin_pictures_path(format: :json), 'picture-selector-ready-value' => local_assigns.fetch(:ready, true).to_s, target: local_assigns[:editor_target] } }
  %button{ type: 'button', class: button_class, disabled: !local_assigns.fetch(:ready, true), data: { action: 'picture-selector#open', 'picture-selector-target' => 'button' } }= button_text
  %p.mt-2.text-sm.text-red-700{ role: 'alert', hidden: true, data: { 'picture-selector-target' => 'error' } }
  .picture-selector-modal-overlay.fixed.inset-0.z-40{ class: 'bg-black/50', hidden: true, data: { action: 'click->picture-selector#close', 'picture-selector-target' => 'overlay' } }
  .picture-selector-modal.fixed.inset-x-4.z-50.mx-auto.max-w-3xl.overflow-y-auto.rounded-xl.bg-white.p-6.shadow-xl{ class: 'top-[8vh] max-h-[84vh]', role: 'dialog', 'aria-modal' => 'true', 'aria-label' => 'Picture selector', hidden: true, data: { 'picture-selector-target' => 'modal' } }
    .mb-5.flex.items-center.justify-between.gap-4
      %h2.text-lg.font-semibold Select a picture
      %button.picture-selector-close-button.rounded.p-2{ type: 'button', class: 'hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-blue-600', 'aria-label' => 'Close picture selector', data: { action: 'picture-selector#close', 'picture-selector-target' => 'closeButton' } }
        = icon(:close)
    .picture-selector-modal-body
      .picture-selector-modal-pictures.grid.grid-cols-2.gap-4{ class: 'sm:grid-cols-3', data: { 'picture-selector-target' => 'pictures' } }
  %template{ data: { 'picture-selector-target' => 'pictureTemplate' } }
    %button.picture-selector-modal-picture.rounded-lg.border.border-slate-200.p-3.text-left{ type: 'button', class: 'hover:bg-blue-50 focus-visible:outline-2 focus-visible:outline-blue-600', data: { action: 'picture-selector#select' } }
      %img.h-24.w-full.object-contain
      %span.title.mt-2.block.break-words.text-sm

#page-contact.page
  %header.page-header
    %h1{ style: 'color: #5e0bb0;' }= t('.title')
  .page-body
    %p.message= t('.message')
    -# Contact remains disabled; retain its inert non-redirecting response.
    = form_for @contact, url: contact_path, html: { data: { turbo: false } } do |f|
      .form-field
        = f.label :name
        = f.text_field :name
      .form-field
        = f.label :email
        = f.email_field :email
      .form-field
        = f.label :phone_number
        = f.text_field :phone_number
      .form-field
        = f.label :subject
        = f.text_field :subject
      .form-field
        = f.label :body
        = f.text_area :body
      .form-field
        = f.submit t('.submit'), class: success_button_class

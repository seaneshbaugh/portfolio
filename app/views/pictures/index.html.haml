%h1{ style: 'color: #3e4ad9;' }= t('.title')
.galleries
  - @galleries.each do |gallery|
    - cover = gallery.featured_or_first_picture
    - next unless cover
    .gallery
      .gallery-preview
        = link_to(image_tag(cover.medium_image_path), picture_path(gallery))
      .gallery-name
        = link_to(gallery.name, picture_path(gallery))

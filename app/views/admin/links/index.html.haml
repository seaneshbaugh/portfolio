%h2.mb-6.text-2xl.font-semibold= t('.title')
.mb-4
  = search_form_for @search, builder: AdminFormBuilder, url: admin_links_path, html: { class: 'grid items-end gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-4', method: :get } do |f|
    .space-y-1.min-w-0
      = f.label :text_cont, t('activerecord.attributes.link.text')
      = f.text_field :text_cont
    .space-y-1.min-w-0
      = f.label :url_cont, t('activerecord.attributes.link.url')
      = f.text_field :url_cont
    .space-y-1.min-w-0
      = f.label :description_cont, t('activerecord.attributes.link.description')
      = f.text_field :description_cont
    .space-y-1.min-w-0
      = f.button search_icon, aria: { label: "Search" }, class: caution_button_class
      = cancel_icon_link(admin_links_path)
- if policy([:admin, Link]).create?
  .mb-4
    .min-w-0
      = link_to t('.new_link'), new_admin_link_path, class: success_button_class
- if @links.present?
  .mb-4
    .min-w-0.overflow-x-auto
      %table.links.min-w-full.divide-y.divide-slate-200.text-sm
        %thead.bg-slate-50.text-left.px-3.py-3.text-left.font-semibold
          %tr
            %th.link-text.px-3.py-3.text-left.font-semibold= sort_link @search, :text
            %th.link-url.px-3.py-3.text-left.font-semibold= sort_link @search, :url
            %th.link-created-at.px-3.py-3.text-left.font-semibold= sort_link @search, :created_at
            %th.edit.px-3.py-3.text-left.font-semibold
            %th.delete.px-3.py-3.text-left.font-semibold
        %tbody.divide-y.divide-slate-200
          - @links.each do |link|
            - present link do |link_presenter|
              %tr{ class: classnames('link', { 'inactive' => !link_presenter.published? }) }
                %td.link-text.px-3.py-3.align-top= link_to(link_presenter.text, admin_link_path(link))
                %td.link-user.px-3.py-3.align-top= link_to(link_presenter.url, link_presenter.url, target: '_blank')
                %td.link-created-at.px-3.py-3.align-top= link_presenter.created_at
                %td.edit.px-3.py-3.align-top
                  - if policy([:admin, link]).edit?
                    = edit_icon_link edit_admin_link_path(link)
                %td.delete.px-3.py-3.align-top
                  - if policy([:admin, link]).destroy?
                    = delete_icon_link admin_link_path(link)
  .mb-4
    .min-w-0
      = paginate @links
- else
  %p.no-items= t('.no_links')

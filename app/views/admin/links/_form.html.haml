= form_for [:admin, @link], builder: AdminFormBuilder, html: { class: 'max-w-4xl space-y-6' } do |f|
  .space-y-1
    = f.label :text
    = f.text_field :text
  .space-y-1
    = f.label :url
    = f.url_field :url
  = f.ace_editor :description, mode: 'rhtml'
  .space-y-1
    = f.label :published_at
    = f.date_field :published_at, value: f.object.published_at&.to_date&.iso8601
  .space-y-1
    = f.label :tag_list
    = f.text_field :tag_list, value: f.object.tag_list.join(', ')
  %p
    = f.label :visible do
      = f.check_box :visible
      %span= t('activerecord.attributes.link.visible')
  .flex.flex-wrap.gap-3
    = f.submit t('submit'), class: success_button_class
    = link_to t('cancel'), admin_links_path, class: info_button_class

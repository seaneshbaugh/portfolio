= form_for [:admin, @picture], builder: AdminFormBuilder, html: { class: 'max-w-4xl space-y-6' } do |f|
  .space-y-1
    = f.label :title
    = f.text_field :title
  .space-y-1
    = f.label :alt_text
    = f.text_field :alt_text
  .space-y-1
    = f.label :caption
    = f.text_field :caption
  .space-y-1
    = f.label :image
    = f.file_field :image, accept: 'image/*'
  .flex.flex-wrap.gap-3
    = f.submit t('submit'), class: success_button_class
    = link_to t('cancel'), admin_pictures_path, class: info_button_class

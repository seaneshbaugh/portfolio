- present @picture do |picture_presenter|
  .mb-4
    .min-w-0
      %h2.mb-6.text-2xl.font-semibold= "#{t('.title')}: #{picture_presenter.title}"
  .mb-4
    .admin-actions.flex.flex-wrap.gap-2
      = link_to t('.back_to_pictures'), admin_pictures_path, class: info_button_class
      - if policy([:admin, @picture]).edit?
        = edit_icon_link(edit_admin_picture_path(@picture), label: t('edit'))
      - if policy([:admin, @picture]).destroy?
        = delete_icon_link(admin_picture_path(@picture), label: t('delete'))
  .picture
    .attribute.preview.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('.preview')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= link_to picture_presenter.medium_image_tag, picture_presenter.original_image_path, target: '_blank'
    .attribute.title.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.picture.title')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.title
    .attribute.slug.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.picture.slug')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.slug
  .attribute.body.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.picture.alt_text')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.alt_text
  .attribute.style.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.picture.caption')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.caption
  .attribute.image-key.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.active_storage/blob.key')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.image_key
  .attribute.image-filename.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.active_storage/blob.filename')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.image_filename
  .attribute.image.content-type.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.active_storage/blob.content_type')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.image_content_type
  .attribute.image-metadata.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.active_storage/blob.metadata')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.image_metadata.inspect
  .attribute.image-byte-size.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.active_storage/blob.byte_size')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
      %span{ title: picture_presenter.image_size(false) }= picture_presenter.image_size
  .attribute.image-checksum.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.active_storage/blob.checksum')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
      %span{ title: picture_presenter.image_checksum }= Digest::hexencode(picture_presenter.image_checksum.unpack('m0').first)
  .attribute.created-at.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.picture.created_at')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.created_at
  .attribute.updated-at.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
    .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.picture.updated_at')
    .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= picture_presenter.updated_at

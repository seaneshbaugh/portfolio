%h2.mb-6.text-2xl.font-semibold= t('.title')
.mb-4
  = search_form_for @search, builder: AdminFormBuilder, url: admin_pictures_path, html: { class: 'grid items-end gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-4', method: :get } do |f|
    .space-y-1.min-w-0
      = f.label :title_cont, t('activerecord.attributes.picture.title')
      = f.text_field :title_cont
    .space-y-1.min-w-0
      = f.label :alt_text_cont, t('activerecord.attributes.picture.alt_text')
      = f.text_field :alt_text_cont
    .space-y-1.min-w-0
      = f.label :caption_cont, t('activerecord.attributes.picture.caption')
      = f.text_field :caption_cont
    .space-y-1.min-w-0
      = f.button search_icon, aria: { label: "Search" }, class: caution_button_class
      = cancel_icon_link(admin_pictures_path)
.pictures-manager{ data: { controller: 'picture-uploads', action: 'turbo:before-cache@document->picture-uploads#disconnect', 'picture-uploads-url-value' => admin_pictures_path, 'picture-uploads-direct-upload-url-value' => rails_direct_uploads_path } }
  - if policy([:admin, Picture]).create?
    .mb-4
      .image-uploader-container.min-w-0
        .image-uploader.rounded-xl.border-2.border-dashed.border-slate-300.bg-white.p-6{ data: { 'picture-uploads-target' => 'dropzone', action: 'dragenter->picture-uploads#dragenter dragover->picture-uploads#dragover dragleave->picture-uploads#dragleave drop->picture-uploads#drop' } }
          %label.mb-3.block.text-sm.font-medium{ for: 'picture-upload-files' }= t('.upload_hint')
          %input#picture-upload-files.block.w-full.text-sm{  class: 'file:mr-3 file:rounded-md file:border-0 file:bg-blue-700 file:px-3 file:py-2 file:text-white file:cursor-pointer', type: 'file', multiple: true, accept: 'image/*', data: { 'picture-uploads-target' => 'input', action: 'change->picture-uploads#choose' } }
          %p.mt-3.text-sm.text-slate-600{ role: 'status', hidden: true, data: { 'picture-uploads-target' => 'status' } }= t('.uploading')
          %ul.mt-3.list-disc.space-y-1.pl-5.text-sm.text-red-700{ role: 'alert', hidden: true, data: { 'picture-uploads-target' => 'errors' } }
  .mb-4
    .picture-list-container.min-w-0.overflow-x-auto
      %table.pictures.min-w-full.divide-y.divide-slate-200.text-sm
        %thead.bg-slate-50.text-left.px-3.py-3.text-left.font-semibold
          %tr
            %th.picture-thumbnail.px-3.py-3.text-left.font-semibold= t('activerecord.attributes.picture.image')
            %th.picture-title.px-3.py-3.text-left.font-semibold= t('activerecord.attributes.picture.title')
            %th.picture-created-at.px-3.py-3.text-left.font-semibold= t('activerecord.attributes.picture.created_at')
            %th.edit.px-3.py-3.text-left.font-semibold
            %th.delete.px-3.py-3.text-left.font-semibold
        %tbody.divide-y.divide-slate-200{ data: { 'picture-uploads-target' => 'rows' } }
          = render partial: 'picture', collection: @pictures
  - if @pictures.present?
    .mb-4
      .min-w-0
        = paginate @pictures
  - else
    %p.no-items{ data: { 'picture-uploads-target' => 'empty' } }= t('.no_pictures')

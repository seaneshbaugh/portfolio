= form_for [:admin, @user], builder: AdminFormBuilder, html: { class: 'max-w-4xl space-y-6' } do |f|
  .space-y-1
    = f.label :first_name
    = f.text_field :first_name
  .space-y-1
    = f.label :last_name
    = f.text_field :last_name
  .space-y-1
    = f.label :email
    = f.email_field :email
  .space-y-1
    = f.label :password
    = f.password_field :password
  .space-y-1
    = f.label :password_confirmation
    = f.password_field :password_confirmation
  %fieldset.space-y-3
    %legend.text-sm.font-medium= t('activerecord.attributes.user.roles')
    = f.collection_check_boxes(:role_ids, Role.all, :id, :name) do |c|
      %div
        = c.label(class: 'inline-flex items-center gap-2 text-sm') do
          = c.check_box(class: 'h-4 w-4 accent-blue-700')
          %span= c.text.titleize
  .flex.flex-wrap.gap-3
    = f.submit t('submit'), class: success_button_class
    = link_to t('cancel'), admin_users_path, class: info_button_class

%h2.mb-6.text-2xl.font-semibold= t('.title')
.mb-4
  = search_form_for @search, builder: AdminFormBuilder, url: admin_users_path, html: { class: 'grid items-end gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-4', method: :get } do |f|
    .space-y-1.min-w-0
      = f.label :first_name_or_last_name_cont, t('activerecord.attributes.user.first_or_last_name')
      = f.text_field :first_name_or_last_name_cont
    .space-y-1.min-w-0
      = f.label :email_cont, t('activerecord.attributes.user.email')
      = f.text_field :email_cont
    .space-y-1.min-w-0
      = f.label :roles_name_eq, t('activerecord.attributes.user.roles')
      = f.select :roles_name_eq, Role.pluck(:name).map { |role| [role.titleize, role] }, include_blank: t('.search.select_role')
    .space-y-1.min-w-0
      = f.button search_icon, aria: { label: "Search" }, class: caution_button_class
      = cancel_icon_link(admin_users_path)
- if policy([:admin, User]).create?
  .mb-4
    .min-w-0
      = link_to t('.new_user'), new_admin_user_path, class: success_button_class
- if @users.present?
  .mb-4
    .min-w-0.overflow-x-auto
      %table.users.min-w-full.divide-y.divide-slate-200.text-sm
        %thead.bg-slate-50.text-left.px-3.py-3.text-left.font-semibold
          %tr
            %th.user-name.px-3.py-3.text-left.font-semibold= sort_link @search, :last_name, [:last_name, :first_name], t('activerecord.attributes.user.full_name')
            %th.user-email.px-3.py-3.text-left.font-semibold= sort_link @search, :email
            %th.user-role.px-3.py-3.text-left.font-semibold= sort_link @search, :roles_name, t('activerecord.attributes.user.roles')
            %th.user-created-at.px-3.py-3.text-left.font-semibold= sort_link @search, :created_at
            %th.edit.px-3.py-3.text-left.font-semibold
            %th.delete.px-3.py-3.text-left.font-semibold
        %tbody.divide-y.divide-slate-200
          - @users.each do |user|
            - present user do |user_presenter|
              %tr.user
                %td.user-name.px-3.py-3.align-top= link_to user_presenter.full_name, admin_user_path(user)
                %td.user-email.px-3.py-3.align-top
                  = user_presenter.email
                  = user_presenter.email_link
                %td.user-roles.px-3.py-3.align-top= user_presenter.roles
                %td.user-created-at.px-3.py-3.align-top= user_presenter.created_at
                %td.edit.px-3.py-3.align-top
                  - if policy([:admin, user]).edit?
                    = edit_icon_link edit_admin_user_path(user)
                %td.delete.px-3.py-3.align-top
                  - if policy([:admin, user]).destroy?
                    = delete_icon_link admin_user_path(user)
  .mb-4
    .min-w-0
      = paginate @users
- else
  %p.no-items= t('.no_users')

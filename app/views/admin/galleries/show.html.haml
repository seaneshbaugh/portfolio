- present @gallery do |gallery_presenter|
  .mb-4
    .min-w-0
      %h2.mb-6.text-2xl.font-semibold= "#{t('.title')}: #{gallery_presenter.name}"
  .mb-4
    .admin-actions.flex.flex-wrap.gap-2
      = link_to t('.back_to_galleries'), admin_galleries_path, class: info_button_class
      - if policy([:admin, @gallery]).edit?
        = edit_icon_link(edit_admin_gallery_path(@gallery), label: t('edit'))
      - if policy([:admin, @gallery]).destroy?
        = delete_icon_link(admin_gallery_path(@gallery), label: t('delete'))
  .gallery
    .attribute.name.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.name')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= gallery_presenter.name
    .attribute.slug.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.slug')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
        = gallery_presenter.slug
        = gallery_presenter.share_link target: '_blank'
    .attribute.description.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.description')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
        - if gallery_presenter.description.present?
          %pre= gallery_presenter.description
    .attribute.order.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.order')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= gallery_presenter.order
    .attribute.visible.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.visible')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= gallery_presenter.visible
    .attribute.created-at.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.created_at')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= gallery_presenter.created_at
    .attribute.updated-at.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.gallery.updated_at')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= gallery_presenter.updated_at

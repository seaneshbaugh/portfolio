- membership = f.object
.gallery-picture.flex.flex-wrap.items-center.gap-4.rounded-lg.border.border-slate-200.bg-white.p-4{ hidden: membership.marked_for_destruction?, draggable: true, data: { 'gallery-index' => f.index, action: 'dragstart->gallery-pictures#dragstart dragover->gallery-pictures#dragover drop->gallery-pictures#drop dragend->gallery-pictures#dragend' } }
  %button{ class: warning_button_class, type: 'button', 'aria-label' => 'Remove picture', data: { action: 'gallery-pictures#remove' } }
    = icon(:delete)
  - if membership.persisted?
    = f.hidden_field :id, data: { 'gallery-picture-field' => 'id' }
  = f.hidden_field :picture_id, data: { 'gallery-picture-field' => 'picture_id' }
  = f.hidden_field :_destroy, value: membership.marked_for_destruction? ? '1' : '0', data: { 'gallery-picture-field' => '_destroy' }
  = f.hidden_field :order, data: { 'gallery-picture-field' => 'order' }
  %img.h-20.w-20.rounded.object-cover{ src: membership.picture&.thumbnail_image_path, alt: membership.picture&.alt_text }
  %span.gallery-picture-title= membership.picture&.title
  .gallery-picture-ordering.flex.flex-wrap.gap-2
    %button.gallery-picture-drag{ class: info_button_class, type: 'button', draggable: true, 'aria-label' => 'Drag picture to reorder' }
      = icon(:drag)
    %button{ class: info_button_class, type: 'button', data: { action: 'gallery-pictures#up' } } Move up
    %button{ class: info_button_class, type: 'button', data: { action: 'gallery-pictures#down' } } Move down
  %p
    = f.label :featured do
      = f.check_box :featured, data: { 'gallery-picture-field' => 'featured', action: 'gallery-pictures#feature' }
      %span Featured
  %p
    = f.label :visible do
      = f.check_box :visible
      %span Visible

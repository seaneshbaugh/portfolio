= form_for [:admin, @gallery], builder: AdminFormBuilder, html: { class: 'max-w-4xl space-y-6' } do |f|
  .space-y-1
    = f.label :name
    = f.text_field :name
  = f.ace_editor :description, mode: 'rhtml'
  .space-y-1
    = f.label :order
    = f.number_field :order
  %p
    = f.label :visible do
      = f.check_box :visible
      %span= t('activerecord.attributes.gallery.visible')
  %h2.text-xl.font-semibold Pictures
  .gallery-pictures-container{ data: { controller: 'gallery-pictures', action: 'picture-selector:select->gallery-pictures#add turbo:before-cache@document->gallery-pictures#disconnect' } }
    .mb-4
      %div{ data: { 'gallery-pictures-target' => 'selector' } }
        = render 'shared/admin/picture_selector', id: 'gallery-picture-selector', button_class: info_button_class, button_text: 'Add Picture', ready: false
    .gallery-pictures-manager{ data: { 'gallery-pictures-target' => 'rows' } }
      = f.fields_for :gallery_pictures, @gallery.gallery_pictures.sort_by { |membership| membership.order || 0 }, include_id: false do |fields|
        = render 'gallery_picture_fields', f: fields
    %template{ data: { 'gallery-pictures-target' => 'template' } }
      = f.fields_for :gallery_pictures, GalleryPicture.new(visible: true, featured: false), child_index: 'NEW_GALLERY_PICTURE', include_id: false do |fields|
        = render 'gallery_picture_fields', f: fields
    %p{ role: 'status', 'aria-live' => 'polite', data: { 'gallery-pictures-target' => 'status' } }
  .flex.flex-wrap.gap-3
    = f.submit t('submit'), class: success_button_class
    = link_to t('cancel'), admin_galleries_path, class: info_button_class

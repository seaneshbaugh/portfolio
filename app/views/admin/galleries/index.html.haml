%h2.mb-6.text-2xl.font-semibold= t('.title')
.mb-4
  = search_form_for @search, builder: AdminFormBuilder, url: admin_galleries_path, html: { class: 'grid items-end gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-4', method: :get } do |f|
    .space-y-1.min-w-0
      = f.label :name_cont, t('activerecord.attributes.gallery.name')
      = f.text_field :name_cont
    .space-y-1.min-w-0
      = f.label :description_cont, t('activerecord.attributes.gallery.description')
      = f.text_field :description_cont
    .space-y-1.min-w-0
      = f.button search_icon, aria: { label: "Search" }, class: caution_button_class
      = cancel_icon_link(admin_galleries_path)
- if policy([:admin, Gallery]).create?
  .mb-4
    .min-w-0
      = link_to t('.new_gallery'), new_admin_gallery_path, class: success_button_class
- if @galleries.present?
  .mb-4
    .min-w-0.overflow-x-auto
      %table.galleries
        %thead.bg-slate-50.text-left.px-3.py-3.text-left.font-semibold
          %tr
            %th.gallery-name.px-3.py-3.text-left.font-semibold= sort_link @search, :name
            %th.gallery-order.hide-on-small-only.px-3.py-3.text-left.font-semibold= sort_link @search, :order
            %th.gallery-created-at.px-3.py-3.text-left.font-semibold= sort_link @search, :created_at
            %th.edit.px-3.py-3.text-left.font-semibold
            %th.delete.px-3.py-3.text-left.font-semibold
        %tbody.divide-y.divide-slate-200
          - @galleries.each do |gallery|
            - present gallery do |gallery_presenter|
              %tr{ class: classnames('gallery', { 'inactive' => !gallery_presenter.published? }) }
                %td.gallery-title.px-3.py-3.align-top
                  = link_to gallery_presenter.name, admin_gallery_path(gallery)
                  = gallery_presenter.share_link target: '_blank'
                %td.gallery-order.hide-on-small-only.px-3.py-3.align-top= gallery_presenter.order
                %td.gallery-created-at.px-3.py-3.align-top= gallery_presenter.created_at
                %td.edit.right-align.px-3.py-3.align-top
                  - if policy([:admin, gallery]).edit?
                    = edit_icon_link edit_admin_gallery_path(gallery)
                %td.delete.right-align.px-3.py-3.align-top
                  - if policy([:admin, gallery]).destroy?
                    = delete_icon_link admin_gallery_path(gallery)
  .mb-4
    .min-w-0
      = paginate @galleries
- else
  %p.no-items= t('.no_galleries')

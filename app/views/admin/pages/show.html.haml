- present @page do |page_presenter|
  .mb-4
    .min-w-0
      %h2.mb-6.text-2xl.font-semibold= "#{t('.title')}: #{page_presenter.title}"
  .mb-4
    .admin-actions.flex.flex-wrap.gap-2
      = link_to t('.back_to_pages'), admin_pages_path, class: info_button_class
      - if policy([:admin, @page]).edit?
        = edit_icon_link(edit_admin_page_path(@page), label: t('edit'))
      - if policy([:admin, @page]).destroy?
        = delete_icon_link(admin_page_path(@page), label: t('delete'))
  .page
    .attribute.title.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.title')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.title
    .attribute.slug.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.slug')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
        = page_presenter.slug
        = page_presenter.share_link target: '_blank'
    .attribute.body.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.body')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
        - if page_presenter.body.present?
          %pre= page_presenter.body
    .attribute.style.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.style')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
        - if page_presenter.style.present?
          %pre= page_presenter.style
    .attribute.script.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.script')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }
        - if page_presenter.script.present?
          %pre= page_presenter.script
    .attribute.order.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.order')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.order
    .attribute.color.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.color')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.color_text
    .attribute.show-in-menu.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.show_in_menu')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.show_in_menu
    .attribute.visible.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.visible')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.visible
    .attribute.created-at.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.created_at')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.created_at
    .attribute.updated-at.grid.gap-2.border-b.border-slate-200.py-3{ class: 'md:grid-cols-4' }
      .attribute-name.text-sm.font-medium.text-slate-600= t('activerecord.attributes.page.updated_at')
      .attribute-value.min-w-0.break-words{ class: 'md:col-span-3' }= page_presenter.updated_at

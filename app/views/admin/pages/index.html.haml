%h2.mb-6.text-2xl.font-semibold= t('.title')
.mb-4
  = search_form_for @search, builder: AdminFormBuilder, url: admin_pages_path, html: { class: 'grid items-end gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 md:grid-cols-4', method: :get } do |f|
    .space-y-1.min-w-0
      = f.label :title_cont, t('activerecord.attributes.page.title')
      = f.text_field :title_cont
    .space-y-1.min-w-0
      = f.label :body_or_style_or_script_cont, t('activerecord.attributes.page.body_or_style_or_script')
      = f.text_field :body_or_style_or_script_cont
    .space-y-1.min-w-0
      = f.button search_icon, aria: { label: "Search" }, class: caution_button_class
      = cancel_icon_link(admin_pages_path)
- if policy([:admin, Page]).create?
  .mb-4
    .min-w-0
      = link_to t('.new_page'), new_admin_page_path, class: success_button_class
- if @pages.present?
  .mb-4
    .min-w-0.overflow-x-auto
      %table.pages
        %thead.bg-slate-50.text-left.px-3.py-3.text-left.font-semibold
          %tr
            %th.page-title.px-3.py-3.text-left.font-semibold= sort_link @search, :title
            %th.page-order.hide-on-small-only.px-3.py-3.text-left.font-semibold= sort_link @search, :order
            %th.page-created-at.px-3.py-3.text-left.font-semibold= sort_link @search, :created_at
            %th.edit.px-3.py-3.text-left.font-semibold
            %th.delete.px-3.py-3.text-left.font-semibold
        %tbody.divide-y.divide-slate-200
          - @pages.each do |page|
            - present page do |page_presenter|
              %tr{ class: classnames('page', { 'inactive' => !page_presenter.published? }) }
                %td.page-title.px-3.py-3.align-top
                  = link_to page_presenter.title, admin_page_path(page)
                  = page_presenter.share_link target: '_blank'
                %td.page-order.hide-on-small-only.px-3.py-3.align-top= page_presenter.order
                %td.page-created-at.px-3.py-3.align-top= page_presenter.created_at
                %td.edit.right-align.px-3.py-3.align-top
                  - if policy([:admin, page]).edit?
                    = edit_icon_link edit_admin_page_path(page)
                %td.delete.right-align.px-3.py-3.align-top
                  - if policy([:admin, page]).destroy?
                    = delete_icon_link admin_page_path(page)
  .mb-4
    .min-w-0
      = paginate @pages
- else
  %p.no-items= t('.no_pages')

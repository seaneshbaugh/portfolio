# Runtime only: copy to .env.production or supply these through Rancher.
# No production values belong in the image or source control.
RAILS_MASTER_KEY=replace_with_the_existing_credentials_key
PORTFOLIO_DATABASE=portfolio_production
PORTFOLIO_DATABASE_USERNAME=portfolio
PORTFOLIO_DATABASE_PASSWORD=replace_at_deployment
PORTFOLIO_DATABASE_HOST=replace_with_database_service
PORTFOLIO_DATABASE_PORT=5432
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1
# Optional overrides for existing DigitalOcean Spaces/S3 storage:
AWS_REGION=nyc3
S3_BUCKET=seaneshbaugh
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SMTP and S3 access credentials remain in Rails encrypted credentials.
# Set only if running without a separate worker service:
# SOLID_QUEUE_IN_PUMA=1

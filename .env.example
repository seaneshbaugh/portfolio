# Local Compose settings only. Copy to .env; retain existing values if already set.
# POSTGRES_* initializes a NEW PostgreSQL data directory. Changing these does not
# change roles/passwords in an existing database.
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_local

PORTFOLIO_DATABASE=portfolio_development
PORTFOLIO_DATABASE_USERNAME=portfolio
PORTFOLIO_DATABASE_PASSWORD=portfolio_local
PORTFOLIO_DATABASE_HOST=db
PORTFOLIO_DATABASE_PORT=5432

# Use a separate database. These credentials reuse the local PostgreSQL role.
PORTFOLIO_TEST_DATABASE=portfolio_test
PORTFOLIO_TEST_DATABASE_USERNAME=portfolio
PORTFOLIO_TEST_DATABASE_PASSWORD=portfolio_local
PORTFOLIO_TEST_DATABASE_HOST=db
PORTFOLIO_TEST_DATABASE_PORT=5432

# Shakapacker host settings are supplied by Compose per service.
# For a native Rails process connecting to Docker's database, use localhost
# for both database hosts instead of db.

# syntax=docker/dockerfile:1
# check=error=true

ARG RUBY_VERSION=4.0.9
ARG NODE_VERSION=26.13.0
FROM node:${NODE_VERSION}-bookworm-slim AS node
RUN npm install --global yarn@1.22.22

# Install only the Node library required at runtime, using the committed lockfile.
FROM node AS javascript
WORKDIR /runtime-js
COPY package.json yarn.lock ./
RUN node -e 'const fs = require("fs"); const p = require("./package.json"); fs.writeFileSync("package.json", JSON.stringify({ private: true, dependencies: { css: p.dependencies.css } }));' && \
    yarn install --frozen-lockfile --production

FROM ruby:${RUBY_VERSION}-slim AS base
WORKDIR /rails
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y curl libjemalloc2 libvips postgresql-client libatomic1 && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/yarn /opt/yarn
RUN ln -s /usr/local/bin/node /usr/local/bin/nodejs && \
    ln -s /opt/yarn/bin/yarn.js /usr/local/bin/yarn

ENV RAILS_ENV="production" \
    BUNDLE_DEPLOYMENT="1" \
    BUNDLE_PATH="/usr/local/bundle" \
    BUNDLE_WITHOUT="development:test" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so"

FROM base AS build
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
ARG BUNDLER_VERSION=4.0.23
RUN gem install bundler --version "${BUNDLER_VERSION}" --no-document
COPY Gemfile Gemfile.lock .tool-versions ./
RUN bundle install --jobs 1 --retry 3 && \
    rm -rf /root/.bundle "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git && \
    bundle exec bootsnap precompile -j 1 --gemfile

COPY . .
COPY --from=javascript /runtime-js/node_modules ./node_modules
RUN bundle exec bootsnap precompile -j 1 app/ lib/

# These placeholders exist only for compilation, not in the runtime environment.
# The build needs neither a database nor production credentials.
RUN SECRET_KEY_BASE_DUMMY=1 AWS_EC2_METADATA_DISABLED=true \
    PORTFOLIO_DATABASE=portfolio_build PORTFOLIO_DATABASE_USERNAME=build \
    PORTFOLIO_DATABASE_PASSWORD=build PORTFOLIO_DATABASE_HOST=127.0.0.1 \
    PORTFOLIO_DATABASE_PORT=5432 ./bin/rails assets:precompile

FROM base AS production
RUN groupadd --system --gid 1000 rails && \
    useradd rails --uid 1000 --gid 1000 --create-home --shell /bin/bash
COPY --chown=rails:rails --from=build /usr/local/bundle /usr/local/bundle
COPY --chown=rails:rails --from=build /rails /rails
RUN mkdir -p /rails/storage && chown rails:rails /rails/storage
USER 1000:1000
ENTRYPOINT ["/rails/bin/docker-entrypoint"]
EXPOSE 3000
CMD ["./bin/rails", "server"]

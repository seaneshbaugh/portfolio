#!/usr/bin/env ruby

require_relative "../config/environment"
require "json"
require "net/http"

# Resolve the same fingerprinted URLs used by layouts and import maps, then
# exercise Rails delivery (including workers, fonts and images) over HTTP.
app_url = ENV.fetch("APP_URL", "http://localhost:3000")
helpers = ApplicationController.helpers
deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 60

loop do
  begin
    Rails.application.assets.load_path.cache_sweeper.execute_if_updated if Rails.application.config.assets.sweep_cache
    imports = JSON.parse(Rails.application.importmap.to_json(resolver: helpers)).fetch("imports").values
    logical_assets = %w[application.css tailwind.css glightbox.css ace/worker-css.js ace/worker-html.js ace/worker-javascript.js]
    logical_assets += Dir.glob(Rails.root.join("app/assets/{images,fonts}/**/*")).select { |file| File.file?(file) }
      .map { |file| file.sub(%r{.*app/assets/(images|fonts)/}, "") }
    assets = (imports + logical_assets.map { |name| helpers.asset_path(name) }).uniq
    assets.each do |asset|
      uri = URI.join(app_url, asset)
      response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 2, read_timeout: 5) do |http|
        http.get(uri.request_uri)
      end
      expected_type = case File.extname(uri.path)
      when ".css" then "text/css"
      when ".js", ".mjs" then "javascript"
      when ".png" then "image/png"
      when ".woff", ".woff2", ".ttf" then "font"
      else raise "Unexpected asset: #{asset}"
      end
      unless response.code == "200" && response["content-type"].to_s.include?(expected_type) && !response.body.to_s.empty?
        raise "#{uri}: HTTP #{response.code}, content type #{response['content-type'].inspect}"
      end
    end
    puts "Propshaft: #{assets.length} asset URLs returned HTTP 200 with expected content types."
    break
  rescue StandardError => error
    abort error.message if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
    sleep 1
  end
end
